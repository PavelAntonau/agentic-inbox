# Cloudflare Access (required in production). TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
POLICY_AUD=your-access-policy-audience-tag
TEAM_DOMAIN=https://your-team.cloudflareaccess.com

# Local-dev only: mock the Workers AI binding so SSR doesn't block on a
# remote-only inference call (OQ-V2U-6). Set to "true" for dev / Playwright;
# leave UNSET in production. Disables prompt-injection scanning + draft verification.
# DEV_MOCK_AI=true

# Phase G-2 — Cloudflare Turnstile.  TURNSTILE_SECRET_KEY is set via
# `wrangler secret put TURNSTILE_SECRET_KEY` for prod; locally use Cloudflare's
# always-passes test secret `1x0000000000000000000000000000000AA`.  The site
# key (public) lives in wrangler.jsonc `vars.TURNSTILE_SITE_KEY`; for the
# always-passes test pair use `1x00000000000000000000AA`.
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

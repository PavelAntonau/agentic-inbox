{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "agentic-inbox",
	"compatibility_date": "2025-11-28",
	"main": "./workers/app.ts",
	"observability": {
		"enabled": true
	},
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		// Production deploys must also define POLICY_AUD and TEAM_DOMAIN.
		// TEAM_DOMAIN may be the base Access URL or the full /cdn-cgi/access/certs URL.
		// The worker now fails closed outside local development if Access is not configured.
		"DOMAINS": "actionnow.ai",
		"EMAIL_ADDRESSES": [],
		// First-login global_owner. Authenticated email matching this value
		// is auto-promoted to global_owner on first request via bootstrapOwner().
		// Tracked in config (not as a secret) so the canonical owner is visible
		// in version control.
		"BOOTSTRAP_OWNER_EMAIL": "pavel@digifirst.org",
		// Phase 6.1 — better-auth base URL. BETTER_AUTH_SECRET is a secret,
		// set via `wrangler secret put BETTER_AUTH_SECRET`.
		// Phase 1 (mcp-oauth, T1.4) — OAUTH_JWT_SIGNING_KEY is a secret holding
		// stringified JSON `{kid,alg,crv,publicJwk,privateJwk}` (Ed25519). Set
		// via `wrangler secret put OAUTH_JWT_SIGNING_KEY`; mirrored in Keychain
		// at `cloudflare/OAUTH_JWT_SIGNING_KEY`.
		"BETTER_AUTH_URL": "https://mail.actionnow.ai",
		// Phase G-2 — Cloudflare Turnstile widget site key (public, safe in repo).
		// Pair with the secret `TURNSTILE_SECRET_KEY` (set via
		// `wrangler secret put TURNSTILE_SECRET_KEY`). The site key drives
		// the client widget; the secret drives server-side siteverify.
		//
		// This is the REAL site key for the `mail.actionnow.ai` Turnstile
		// widget (account 3e96bfb3a3edded75b781064e5d743a3, created
		// 2026-05-07 via the CF API). For local dev, `.dev.vars` overrides
		// this key with Cloudflare's always-pass test pair so the OTP-send
		// path doesn't need a real challenge response. Mirrored in Keychain
		// at cloudflare/turnstile-sitekey for reference.
		"TURNSTILE_SITE_KEY": "0x4AAAAAADK-roDEjck74qJj",
		// Phase G / G-3 — tier-1 auth alerter destination + sender.
		// ADMIN_ALERT_EMAIL receives the alert (off-domain by design — admin
		// preference 2026-05-07: a mail.actionnow.ai outage must not suppress
		// alerts about itself; Slack/Teams/etc. intentionally not used).
		// ADMIN_ALERT_FROM is the Resend sender — must be on a verified
		// domain. The alerter also requires the existing RESEND_API_KEY
		// secret. If any of the three is missing, the alerter skips silently.
		"ADMIN_ALERT_EMAIL": "pavel@digifirst.org",
		"ADMIN_ALERT_FROM": "noreply@actionnow.ai"
	},
	// Outbound mail goes through Resend (workers/lib/resend-client.ts) — the
	// previous Cloudflare Email Routing `send_email` binding was reply-only /
	// verified-destination-only and could not deliver invitations to fresh
	// recipients. The Resend API key is supplied via:
	//     wrangler secret put RESEND_API_KEY
	// Inbound mail still uses Cloudflare Email Routing rules (config, not a
	// binding) pointed at this Worker; the /api/__test__/email-ingest endpoint
	// exercises the inbound path directly via MailboxDO.
	"r2_buckets": [
		{
			"binding": "BUCKET",
			"bucket_name": "agentic-inbox",
			"preview_bucket_name": "agentic-inbox"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "agentic-inbox-control-plane",
			"database_id": "d3d6fb15-bd66-41e0-9e05-78df2c840489",
			"migrations_dir": "./workers/db/control-plane/migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "MAILBOX",
				"class_name": "MailboxDO"
			},
			{
				"name": "EMAIL_AGENT",
				"class_name": "EmailAgent"
			},
			{
				"name": "EMAIL_MCP",
				"class_name": "EmailMCP"
			},
			{
				"name": "AGENT_TOKEN_LIMITER",
				"class_name": "AgentTokenLimiter"
			},
			{
				"name": "REVOCATION_CACHE",
				"class_name": "RevocationCache"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"MailboxDO"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"EmailAgent"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"EmailMCP"
			]
		},
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"AgentTokenLimiter",
				"RevocationCache"
			]
		}
	],
	// Phase v1.1 G-5 — Analytics Engine dataset for rate-limit observability.
	// Binding name: AE  Dataset name: rate_limit_events
	//
	// Per D-G5-EMIT-PROVENANCE (`uoMZ8W6h0qozp_Q2251jT`), every emit site
	// stamps a fixed schema:
	//   blobs   = [route, actor, outcome]
	//   doubles = [count, latency_ms]
	//   indexes = [ip_or_session_id]
	// Schema comment lives at every emit site (AE has no enforced schema).
	//
	// AE re-enable is operator-only (Cloudflare dash → Workers & Pages →
	// mail-actionnow-ai → Settings → Bindings → Add → Analytics Engine).
	// There is no API path to flip the account-level toggle; deploys with
	// this block declared will fail with API error 10089 until the
	// dashboard click is performed (see commit e2482f3 for prior context).
	//
	// Phase G / G-3 follow-up — the legacy `AUTH_ANALYTICS`/`auth_events`
	// binding (auth-event mirror, distinct dataset) remains commented out
	// pending its own re-enable cycle. workers/lib/audit-log.ts:231 still
	// guards the legacy mirror with `if (row.analyticsEngine && row.ctx)`,
	// so its absence is a no-op, not a crash.
	// "analytics_engine_datasets": [
	//	{ "binding": "AUTH_ANALYTICS", "dataset": "auth_events" },
	// ],
	"analytics_engine_datasets": [
		{ "binding": "AE", "dataset": "rate_limit_events" }
	],
	// Phase v1.1 G-5 — Workers Rate Limit binding (Cloudflare native edge
	// rate limiter; runs IN-Worker via `await env.RL_*.limit({key})`).
	//
	// Namespace registry — D-G5-NAMESPACE-REGISTRY (`qOehAbS93fLh-VkJ4u9cf`)
	// fixes sequential allocation; namespace IDs are immutable once chosen.
	//   1001 = RL_LOGIN          — pre-auth /login POST          (5 req / 10s)
	//   1002 = RL_LOGIN_VERIFY   — pre-auth /login/verify POST  (10 req / 60s)
	//   1003 = RL_API_MESSAGES   — post-auth /api/messages       (200 req / 60s)
	//
	// Per D-PG-G5-ARCH (`Ul_YET43hsABcWM901XDm`): edge counter is per-colo
	// loose; the existing app-layer rate-limiter
	// (workers/middleware/auth-rate-limit.ts) remains the global tight
	// limiter. Both run; D-PG-1 sizing rule (`MoK4pLGOtP08xrr_Ewkvd`) holds.
	//
	// Thresholds chosen via formula `cf_threshold = max(app_sustained,
	// k × P99)` with k=2 (login pre-auth) / 3 (verify pre-auth) / 4-5
	// (post-auth). Re-tune via wrangler.jsonc + redeploy ONLY (req_api_only_threshold
	// `CYC23X_1LUXNiEh8byU5D`) — never via dashboard.
	"ratelimits": [
		{
			"name": "RL_LOGIN",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 10 }
		},
		{
			"name": "RL_LOGIN_VERIFY",
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "RL_API_MESSAGES",
			"namespace_id": "1003",
			"simple": { "limit": 200, "period": 60 }
		}
	],
	// Phase G / G-3 — Cron trigger for the tier-1 auth alerter.
	// Handler: workers/cron/auth-alerter.ts → exported `scheduled` handler.
	// Fires every 2 minutes. Sends a single email per fingerprint to
	// `vars.ADMIN_ALERT_EMAIL` via Resend (`RESEND_API_KEY` secret), with
	// a 5-minute in-isolate dedup window. No Slack/Teams/etc.
	"triggers": {
		"crons": ["*/2 * * * *"]
	}
}
